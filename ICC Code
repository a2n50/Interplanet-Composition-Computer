astronaut_count = int(input())
#for loop to get the gender and age of each astronaut
for astronaut in range(astronaut_count):
    gender = input("What is the gender of astronaut {}? (M/F):".format(astronaut + 1)).strip().lower()
    age = int(input("What is the age of astronaut {}?:".format(astronaut + 1)))
    if gender == "f":
        if age < 20:
            ox_liter_perhour = 6.7
        else:
            ox_liter_perhour = 13.8
    elif gender == "m":
        if age < 20:
            ox_liter_perhour = 7
        else:
            ox_liter_perhour = 16.8
